# Business Ultra 2 — environment template (names only; never commit real values)
# Copy to `.env.local` (preferred for local pnpm) and/or `.env` (Docker Compose / legacy).
# Priority (API, development/test): process env → `.env.local` → `.env`
# Production/CI: inject the same names as platform env / GitHub Secrets — no file auto-load.
# Tags: Required | Optional | Planned | CI-only

# =============================================================================
# Core / Runtime
# =============================================================================

# Required — Node runtime mode
NODE_ENV=development

# Required — local ports (compose / Vite). Keep 8741/8742 unless you change all URLs.
WEB_PORT=8741
API_PORT=8742

# Required — public origins (OAuth redirects + CORS). Local defaults use 127.0.0.1.
PUBLIC_WEB_URL=http://127.0.0.1:8741
PUBLIC_API_URL=http://127.0.0.1:8742
CORS_ORIGIN=http://127.0.0.1:8741

# Optional (web build only) — bake API origin into the static bundle when not same-origin.
# VITE_API_URL=http://127.0.0.1:8742

# =============================================================================
# Database
# =============================================================================

# Required — Postgres role/db for docker compose + local clients
POSTGRES_USER=bu2
POSTGRES_PASSWORD=bu2_local_dev_change_me
POSTGRES_DB=bu2

# Required — must match POSTGRES_* (host `postgres` inside compose; `127.0.0.1` for host pnpm)
DATABASE_URL=postgresql://bu2:bu2_local_dev_change_me@127.0.0.1:5432/bu2

# =============================================================================
# Auth / encryption (global app secrets — not per-business)
# =============================================================================

# Required — AES-256-GCM master for Integration Core credential seal (≥16 chars; use crypto.randomBytes)
SECRETS_MASTER_KEY=

# Required — session cookie + OAuth state HMAC (≥16 chars)
SESSION_SECRET=

# Required — first superadmin / breakglass (seeded via pnpm db:seed)
BOOTSTRAP_OWNER_EMAIL=raccoova@gmail.com
# Required locally — invite-only after bootstrap; keep weak values out of production
BOOTSTRAP_OWNER_PASSWORD=

# =============================================================================
# Platform Brevo (auth magic-link / OTP)
# =============================================================================

# Optional — empty in local → API prints magic link to console
BREVO_API_KEY=
# Optional — defaults exist in env schema if omitted
BREVO_SENDER_EMAIL=social@halteverbot123.de
BREVO_SENDER_NAME=Business Ultra

# =============================================================================
# Messaging OAuth (platform client apps — shared across businesses)
# Redirect URIs are derived from PUBLIC_API_URL (do not invent GOOGLE_OAUTH_REDIRECT_URI):
#   {PUBLIC_API_URL}/api/oauth/google/callback
#   {PUBLIC_API_URL}/api/oauth/microsoft/callback
#   {PUBLIC_API_URL}/api/oauth/meta/callback
# Production example: https://business-ultra.raccoova.com/api/oauth/google/callback
# Leave blank until the client is created — empty = fail-closed (503), not fake CHANGE_ME.
# Per-business access/refresh tokens are stored encrypted in Integration Core, not here.
# =============================================================================

# Optional — Google Cloud OAuth client (one client for Gmail + YouTube + Google Ads connects)
# Enable APIs: Gmail, YouTube Data API v3, Google Ads API. Redirect:
#   {PUBLIC_API_URL}/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional — Microsoft / Outlook
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Optional — Azure tenant (`common` multi-tenant default)
MICROSOFT_OAUTH_TENANT=common

# Optional — Meta (Instagram / WhatsApp / Facebook messaging share one app callback)
META_OAUTH_APP_ID=
META_OAUTH_APP_SECRET=

# =============================================================================
# Unipile (optional personal Telegram / aggregator)
# =============================================================================

# Optional — both required together; else connect/sync returns 503
UNIPILE_DSN=
UNIPILE_ACCESS_TOKEN=

# =============================================================================
# Sidecars
# =============================================================================

# Required if OpenSEO sidecar is used
OPENSEO_BASE_URL=http://127.0.0.1:8750
OPENSEO_SSO_SHARED_SECRET=

# Required if Sortanize sidecar is used
SORTANIZE_URL=http://127.0.0.1:8760

# =============================================================================
# Uploads / backups
# =============================================================================

# Optional — API file uploads root
UPLOADS_DIR=./uploads

# Planned — ops backup helpers (not required for app boot)
# BACKUP_GPG_RECIPIENT=ops@example.com
# BACKUP_DIR=./backups

# =============================================================================
# Planned platform env (not loaded by env.ts yet — do not treat as live)
# Prefer business-scoped keys via Settings / Integration Core when adapters exist.
# =============================================================================

# METRICOOL_API_KEY=
# TIKTOK_OAUTH_CLIENT_KEY=
# TIKTOK_OAUTH_CLIENT_SECRET=
# LINKEDIN_OAUTH_CLIENT_ID=
# LINKEDIN_OAUTH_CLIENT_SECRET=
# PINTEREST_OAUTH_CLIENT_ID=
# PINTEREST_OAUTH_CLIENT_SECRET=
# X_OAUTH_CLIENT_ID=
# X_OAUTH_CLIENT_SECRET=
# SNAPCHAT_OAUTH_CLIENT_ID=
# SNAPCHAT_OAUTH_CLIENT_SECRET=

# =============================================================================
# CI-only (GitHub Actions — see .github/SECRETS.md; not needed in .env.local)
# =============================================================================

# OPENSEO_IMAGE_DIGEST=
# E2E_NO_SERVER=1
# BU2_API_URL=
