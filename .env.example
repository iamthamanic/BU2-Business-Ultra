# Business Ultra 2 — local / deploy env (names only; never commit real values)
# Copy to .env for local docker compose / pnpm scripts.
# Production/CI: set the same names as GitHub Secrets (see README.md).

# --- Core ---
NODE_ENV=development
WEB_PORT=8741
API_PORT=8742
PUBLIC_WEB_URL=http://127.0.0.1:8741
PUBLIC_API_URL=http://127.0.0.1:8742
CORS_ORIGIN=http://127.0.0.1:8741

# --- Postgres ---
POSTGRES_USER=bu2
POSTGRES_PASSWORD=bu2_local_dev_change_me
POSTGRES_DB=bu2
DATABASE_URL=postgresql://bu2:bu2_local_dev_change_me@127.0.0.1:5432/bu2

# --- Auth / crypto ---
# 32+ byte secret used to seal API keys at rest (AES-256-GCM)
SECRETS_MASTER_KEY=change-me-to-a-long-random-string-32b-min
# Session cookie signing
SESSION_SECRET=change-me-session-secret-long-random
# Bootstrap breakglass / first superadmin (invite-only after)
BOOTSTRAP_OWNER_EMAIL=raccoova@gmail.com
# Local password for bootstrap owner (seeded via pnpm db:seed). Change in real deploys.
BOOTSTRAP_OWNER_PASSWORD=change-me-local
# Magic-link sender (Brevo)
BREVO_SENDER_EMAIL=social@halteverbot123.de
BREVO_SENDER_NAME=Business Ultra

# --- Platform Brevo (auth magic-link / OTP). Dev fallback: link printed to API console ---
BREVO_API_KEY=

# --- Optional platform defaults (business keys live encrypted in Settings UI) ---
# METRICOOL_API_KEY=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# META_ADS_ACCESS_TOKEN=
# TIKTOK_ADS_ACCESS_TOKEN=
# CHATGPT_ADS_API_KEY=

# --- OpenSEO ---
OPENSEO_BASE_URL=http://127.0.0.1:8750
OPENSEO_SSO_SHARED_SECRET=change-me-openseo-sso-secret
# Pin digest in openseo/docker-compose.yml

# --- Sortanize sidecar ---
SORTANIZE_URL=http://127.0.0.1:8760

# --- Uploads ---
UPLOADS_DIR=./uploads

# --- Backups ---
# BACKUP_GPG_RECIPIENT=ops@example.com
# BACKUP_DIR=./backups
